# Copy to .env and fill in. NEVER commit .env. Use SANDBOX / TEST credentials only in development.
# Variable names for third-party providers below are placeholders: verify against each provider's current docs
# and rename here and in the Zod env schema if the docs say otherwise (record in docs/DECISIONS.md).

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_LOCALE=ar
SESSION_SECRET=change-me-32+chars-random
PHONE_HASH_PEPPER=change-me-32+chars-random   # HMAC pepper for debtors.phone_hash (never rotate casually)

# --- Safety switches (keep these defaults in dev and CI) ---
DRY_RUN_MESSAGING=true        # render messages but never call real WhatsApp/SMS
RUN_SANDBOX_TESTS=0           # set to 1 only to run real-sandbox contract tests
FEATURE_SHARED_BEHAVIOR=false # must stay false until legal sign-off
NEXT_PUBLIC_BRAND_FONT=off    # on only after the font license answer is logged in docs/DECISIONS.md

# --- Database / queue ---
DATABASE_URL=postgres://tahseel:tahseel@localhost:5432/tahseel
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tahseel-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit locally) ---
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Tahseel <no-reply@localhost>"

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_API_VERSION=            # fill from Meta's current docs
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=             # used to verify X-Hub-Signature-256
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me

# --- SMS fallback ---
SMS_PROVIDER=                    # provider chosen by the human
SMS_API_KEY=
SMS_SENDER_ID=

# --- Paymob (sandbox first; shapes verified in DECISIONS.md ADR-019) ---
PAYMOB_SECRET_KEY=               # sk_* server-side only: intention creation + refunds
PAYMOB_PUBLIC_KEY=               # pk_* safe for checkout URLs
PAYMOB_API_KEY=                  # transaction inquiry only (auth-token flow)
PAYMOB_INTEGRATION_ID=           # card integration id; test/live must match the keys
PAYMOB_HMAC_SECRET=              # webhook HMAC-SHA512 validation
PAYMOB_ALLOW_FAKE=false          # production only: allow the fake provider (e2e); keep false in real deploys
PAYMOB_BASE_URL=https://accept.paymob.com

# --- LLM (Anthropic API) ---
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5       # verify current model IDs and prices in Anthropic docs
LLM_MODEL_VISION=claude-sonnet-5-5
LLM_MONTHLY_BUDGET_USD=50             # hard stop: the wrapper must refuse calls above this
LLM_PER_TENANT_DAILY_BUDGET_USD=2

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info
