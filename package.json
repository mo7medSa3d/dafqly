{
  "name": "tahseel",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tahseel/web dev",
    "start": "pnpm --filter @tahseel/web start",
    "worker": "pnpm --filter @tahseel/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . && node scripts/check-no-hardcoded-brand.mjs && node scripts/check-secrets.mjs && node scripts/check-message-parity.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm db:migrate && RESET_SEED=1 DEMO_PASSWORD=demo-password-123 pnpm db:seed && pnpm --filter @tahseel/web test:e2e",
    "eval": "pnpm --filter @tahseel/eval eval",
    "db:migrate": "pnpm --filter @tahseel/db migrate",
    "db:seed": "pnpm --filter @tahseel/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ],
    "overrides": {
      "drizzle-orm": "^0.45.4",
      "postcss": "^8.5.32",
      "tinypool": "^2.2.0",
      "tmp": "^0.2.6",
      "zod": "4.6.7"
    }
  }
}
